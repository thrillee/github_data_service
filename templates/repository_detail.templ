package templates

import (
	"github.com/thrillee/gds/internals/db"
	"fmt"
)

templ RepositoryDetail(repo db.Repository, commitCount int64) {
	@base(repo.FullName) {
		<div id="main-content">
			<div class="mb-6">
				<a href="/repositories" class="text-blue-600 hover:text-blue-800">
					<i class="fas fa-arrow-left mr-2"></i>Back to Repositories
				</a>
			</div>
			<div class="bg-white shadow-md rounded-lg p-6 mb-6">
				<div class="flex justify-between items-start">
					<h1 class="text-2xl font-bold mb-2">{ repo.FullName }</h1>
					<div>
						<button
							class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mr-2"
							hx-post={ string(templ.SafeURL("/repositories/" + fmt.Sprintf("%d", repo.ID) + "/sync")) }
							hx-swap="none"
							hx-indicator="#sync-indicator"
						>
							<i class="fas fa-sync-alt mr-2"></i>Sync Now
							<span id="sync-indicator" class="htmx-indicator ml-1">
								<i class="fas fa-spinner fa-spin"></i>
							</span>
						</button>
						<button
							class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded"
							hx-get={ "/repositories/" + fmt.Sprintf("%d", repo.ID) + "/reset-sync-modal" }
							hx-target="#modal-container"
							hx-swap="innerHTML"
						>
							<i class="fas fa-calendar-alt mr-2"></i>Reset Sync Date
						</button>
					</div>
				</div>
				if repo.Description.Valid {
					<p class="text-gray-700 mb-4">{ repo.Description.String }</p>
				} else {
					<p class="text-gray-500 italic mb-4">No description</p>
				}
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
					<div class="bg-gray-50 p-4 rounded-lg">
						<h3 class="text-sm uppercase text-gray-500 font-semibold">Language</h3>
						<p class="text-lg font-medium">
							if repo.Language.Valid {
								{ repo.Language.String }
							} else {
								<span class="text-gray-400">Unknown</span>
							}
						</p>
					</div>
					<div class="bg-gray-50 p-4 rounded-lg">
						<h3 class="text-sm uppercase text-gray-500 font-semibold">Stars</h3>
						<p class="text-lg font-medium">
							if repo.StargazersCount.Valid {
								{ fmt.Sprintf("%d", repo.StargazersCount.Int64) }
							} else {
								<span class="text-gray-400">0</span>
							}
						</p>
					</div>
					<div class="bg-gray-50 p-4 rounded-lg">
						<h3 class="text-sm uppercase text-gray-500 font-semibold">Forks</h3>
						<p class="text-lg font-medium">
							if repo.ForksCount.Valid {
								{ fmt.Sprintf("%d", repo.ForksCount.Int64) }
							} else {
								<span class="text-gray-400">0</span>
							}
						</p>
					</div>
					<div class="bg-gray-50 p-4 rounded-lg">
						<h3 class="text-sm uppercase text-gray-500 font-semibold">Commits</h3>
						<p class="text-lg font-medium">{ fmt.Sprintf("%d", commitCount) }</p>
					</div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
					<div class="bg-gray-50 p-4 rounded-lg">
						<h3 class="text-sm uppercase text-gray-500 font-semibold">Last Synced</h3>
						<p class="text-lg font-medium">
							if repo.LastSyncedAt.Valid {
								{ repo.LastSyncedAt.Time.Format("Jan 02, 2006 15:04:05") }
							} else {
								<span class="text-gray-400">Never</span>
							}
						</p>
					</div>
					<div class="bg-gray-50 p-4 rounded-lg">
						<h3 class="text-sm uppercase text-gray-500 font-semibold">Sync From Date</h3>
						<p class="text-lg font-medium">
							if repo.SyncFromDate.Valid {
								{ repo.SyncFromDate.Time.Format("Jan 02, 2006") }
							} else {
								<span class="text-gray-400">All time</span>
							}
						</p>
					</div>
				</div>
			</div>
			<div class="flex flex-col md:flex-row gap-6">
				<div class="bg-white shadow-md rounded-lg p-6 w-full md:w-1/2">
					<div class="flex justify-between items-center mb-4">
						<h2 class="text-xl font-bold">Recent Commits</h2>
						<a
							href={ templ.SafeURL("/repositories/" + fmt.Sprintf("%d", repo.ID) + "/commits") }
							class="text-blue-600 hover:text-blue-800"
						>View All</a>
					</div>
					<div
						hx-get={ string(templ.SafeURL("/repositories/" + fmt.Sprintf("%d", repo.ID) + "/commits?size=5&partial=commits")) }
						hx-trigger="load"
						hx-indicator="#commits-loading"
					>
						<div id="commits-loading" class="htmx-indicator flex justify-center my-8">
							<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
						</div>
					</div>
				</div>
				<div class="bg-white shadow-md rounded-lg p-6 w-full md:w-1/2">
					<div class="flex justify-between items-center mb-4">
						<h2 class="text-xl font-bold">Top Contributors</h2>
						<a
							href={ templ.SafeURL("/repositories/" + fmt.Sprintf("%d", repo.ID) + "/authors") }
							class="text-blue-600 hover:text-blue-800"
						>View All</a>
					</div>
					<div
						hx-get={ string(templ.SafeURL("/repositories/" + fmt.Sprintf("%d", repo.ID) + "/authors?limit=5&partial=authors")) }
						hx-trigger="load"
						hx-indicator="#authors-loading"
					>
						<div id="authors-loading" class="htmx-indicator flex justify-center my-8">
							<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
						</div>
					</div>
				</div>
			</div>
			<!-- Modal container for forms -->
			<div
				id="modal-container"
				class="hidden fixed inset-0 overflow-y-auto bg-black bg-opacity-50 flex items-center justify-center"
			>
				<!-- Modal content will be injected here -->
			</div>
		</div>
	}
}
