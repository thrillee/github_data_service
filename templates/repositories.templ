package templates

import "github.com/thrillee/gds/internals/db"

templ RepositoriesPage(repositories []db.Repository) {
	@base("Repositories") {
		<div id="main-content">
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-2xl font-bold">Repositories</h1>
				<button
					class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
					hx-get="/static/add_repository_form.html"
					hx-target="#modal-container"
					hx-swap="innerHTML"
				>
					Add Repository
				</button>
			</div>
			<!-- Directly render the repository list -->
			@RepositoryList(repositories)
			<!-- Modal container for forms -->
			<div
				id="modal-container"
				class="hidden fixed inset-0 overflow-y-auto bg-black bg-opacity-50 flex items-center justify-center"
			>
				<!-- Modal content will be injected here -->
			</div>
		</div>
	}
}
