package templates

import (
	"github.com/thrillee/gds/internals/db"
	"crypto/md5"
	"encoding/hex"
)

func md5Hash(email string) string {
	hash := md5.Sum([]byte(email))
	return hex.EncodeToString(hash[:])
}

templ CommitsList(data struct {
	Repository   db.Repository
	Commits      []db.Commit
	CurrentPage  int
	TotalPages   int64
	TotalCommits int64
	PageSize     int
}) {
	<div class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Commit</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Author</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				if len(data.Commits) == 0 {
					<tr>
						<td colspan="3" class="px-6 py-4 text-center text-gray-500">
							No commits found for this repository.
						</td>
					</tr>
				} else {
					for _, commit := range data.Commits {
						<tr class="hover:bg-gray-50">
							<td class="px-6 py-4">
								<a
									href={ templ.SafeURL(commit.HtmlUrl) }
									target="_blank"
									class="text-blue-600 hover:underline"
								>
									<span class="font-mono text-xs text-gray-500">
										{ commit.Sha[:7] }
									</span>
								</a>
								<p class="mt-1">{ truncate(commit.Message, 80) }</p>
							</td>
							<td class="px-6 py-4">
								<div class="flex items-center">
									<img
										class="h-8 w-8 rounded-full bg-gray-200"
										src={ "https://www.gravatar.com/avatar/" + md5Hash(commit.AuthorEmail) + "?s=80&d=identicon" }
										alt={ commit.AuthorName }
									/>
									<div class="ml-3">
										<p class="text-sm font-medium text-gray-900">{ commit.AuthorName }</p>
										<p class="text-sm text-gray-500">{ commit.AuthorEmail }</p>
									</div>
								</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
								{ commit.CommitDate.Format("Jan 02, 2006 15:04:05") }
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}
