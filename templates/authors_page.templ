package templates

import (
	"github.com/thrillee/gds/internals/db"
	"fmt"
)

templ AuthorsPage(data struct {
	Repository db.Repository
	Authors    []db.GetTopCommitAuthorsRow
	Limit      int64
}) {
	@base("Authors - " + data.Repository.FullName) {
		<div id="main-content">
			<div class="mb-6">
				<a
					href={ templ.SafeURL("/repositories/" + fmt.Sprintf("%d", data.Repository.ID)) }
					class="text-blue-600 hover:text-blue-800"
				>
					<i class="fas fa-arrow-left mr-2"></i>Back to Repository
				</a>
			</div>
			<div class="bg-white shadow-md rounded-lg p-6 mb-6">
				<h1 class="text-2xl font-bold mb-2">
					Top Contributors for { data.Repository.FullName }
				</h1>
				<p class="text-gray-600 mb-4">
					Showing top { fmt.Sprintf("%d", data.Limit) } contributors
				</p>
				<div class="mb-4">
					<label for="limit-select" class="block text-sm font-medium text-gray-700 mb-1">
						Show top:
					</label>
					<div class="inline-flex">
						<select
							id="limit-select"
							class="block w-auto rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
							hx-get={ string(templ.SafeURL("/repositories/" + fmt.Sprintf("%d", data.Repository.ID) + "/authors")) }
							hx-trigger="change"
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-include="[name='limit']"
							hx-indicator="#authors-loading"
						>
							<option value="5" selected?={ data.Limit == 5 }>5 contributors</option>
							<option value="10" selected?={ data.Limit == 10 }>10 contributors</option>
							<option value="25" selected?={ data.Limit == 25 }>25 contributors</option>
							<option value="50" selected?={ data.Limit == 50 }>50 contributors</option>
							<option value="100" selected?={ data.Limit == 100 }>100 contributors</option>
						</select>
						<input type="hidden" name="limit" value={ fmt.Sprintf("%d", data.Limit) }/>
					</div>
				</div>
				<!-- Loading indicator -->
				<div id="authors-loading" class="htmx-indicator flex justify-center my-8">
					<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500"></div>
				</div>
				<!-- Authors list -->
				<div hx-indicator="#authors-loading">
					@AuthorsList(data)
				</div>
			</div>
		</div>
	}
}
