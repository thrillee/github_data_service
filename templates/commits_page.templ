package templates

import (
	"github.com/thrillee/gds/internals/db"
	"fmt"
)

templ CommitsPage(data struct {
	Repository   db.Repository
	Commits      []db.Commit
	CurrentPage  int
	TotalPages   int64
	TotalCommits int64
	PageSize     int
}) {
	@base("Commits - " + data.Repository.FullName) {
		<div id="main-content">
			<div class="mb-6">
				<a
					href={ templ.SafeURL("/repositories/" + fmt.Sprintf("%d", data.Repository.ID)) }
					class="text-blue-600 hover:text-blue-800"
				>
					<i class="fas fa-arrow-left mr-2"></i>Back to Repository
				</a>
			</div>
			<div class="bg-white shadow-md rounded-lg p-6 mb-6">
				<h1 class="text-2xl font-bold mb-2">
					Commits for { data.Repository.FullName }
				</h1>
				<p class="text-gray-600 mb-4">
					Showing { fmt.Sprintf("%d", data.TotalCommits) } commits
					if data.Repository.SyncFromDate.Valid {
						since { data.Repository.SyncFromDate.Time.Format("Jan 02, 2006") }
					}
				</p>
				<!-- Loading indicator -->
				<div id="commits-loading" class="htmx-indicator flex justify-center my-8">
					<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500"></div>
				</div>
				<!-- Commits list -->
				<div clahs="mb-6" hx-indicator="#commits-loading">
					@CommitsList(data)
				</div>
			</div>
		</div>
	}
}
