package templates

templ base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<!-- Tailwind CSS -->
			<script src="https://cdn.tailwindcss.com"></script>
			<!-- HTMX -->
			<script src="https://unpkg.com/htmx.org@1.9.2"></script>
			<!-- Font Awesome -->
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
			<style>
                .htmx-indicator {
                    opacity: 0;
                    transition: opacity 500ms ease-in;
                }
                .htmx-request .htmx-indicator {
                    opacity: 1;
                }
                .htmx-request.htmx-indicator {
                    opacity: 1;
                }
            </style>
		</head>
		<body class="bg-gray-100 min-h-screen">
			<nav class="bg-gray-800 text-white p-4">
				<div class="container mx-auto flex justify-between items-center">
					<a href="/" class="text-xl font-bold">GitHub Data Service</a>
					<div>
						<a href="/repositories" class="hover:bg-gray-700 px-3 py-2 rounded">Repositories</a>
					</div>
				</div>
			</nav>
			<div class="container mx-auto p-4">
				<!-- Alert message container -->
				<div id="alert-container" class="mb-4 hidden">
					<div id="alert" class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-4">
						<div class="flex">
							<div class="py-1"><i class="fas fa-info-circle"></i></div>
							<div class="ml-3">
								<p id="alert-message"></p>
							</div>
						</div>
					</div>
				</div>
				<!-- Content will be injected here -->
				{ children... }
			</div>
			<div></div>
			<footer class="bg-gray-800 text-white margin-top-[32px] top-0 p-4 mt-8">
				<div class="container mx-auto text-center">
					<p>GitHub Data Service &copy; 2025</p>
				</div>
			</footer>
			<script>
                // Helper function to show alerts
                function showAlert(message, type = "info") {
                    const alertContainer = document.getElementById("alert-container");
                    const alertElement = document.getElementById("alert");
                    const alertMessage = document.getElementById("alert-message");

                    // Set message
                    alertMessage.textContent = message;

                    // Set alert type
                    alertElement.className = "border-l-4 p-4";

                    if (type === "success") {
                        alertElement.classList.add(
                            "bg-green-100",
                            "border-green-500",
                            "text-green-700",
                        );
                    } else if (type === "error") {
                        alertElement.classList.add(
                            "bg-red-100",
                            "border-red-500",
                            "text-red-700",
                        );
                    } else if (type === "warning") {
                        alertElement.classList.add(
                            "bg-yellow-100",
                            "border-yellow-500",
                            "text-yellow-700",
                        );
                    } else {
                        alertElement.classList.add(
                            "bg-blue-100",
                            "border-blue-500",
                            "text-blue-700",
                        );
                    }

                    // Show alert
                    alertContainer.classList.remove("hidden");

                    // Hide after 5 seconds
                    setTimeout(() => {
                        alertContainer.classList.add("hidden");
                    }, 5000);
                }

                // Event listeners for HTMX events
                document.body.addEventListener("htmx:responseError", function (evt) {
                    showAlert("Error: " + evt.detail.xhr.responseText, "error");
                });

                document.body.addEventListener("repositorySynced", function (evt) {
                    showAlert("Repository sync started successfully!", "success");
                    // Refresh the repository details after 1 second
                    setTimeout(() => {
                        const repoId = window.location.pathname.split("/").pop();
                        htmx.ajax("GET", `/repositories/${repoId}`, "#main-content");
                    }, 1000);
                });

                document.body.addEventListener("syncDateUpdated", function (evt) {
                    showAlert("Sync date updated successfully!", "success");
                    // Refresh the repository details
                    const repoId = window.location.pathname.split("/").pop();
                    htmx.ajax("GET", `/repositories/${repoId}`, "#main-content");
                });
            </script>
		</body>
	</html>
}
